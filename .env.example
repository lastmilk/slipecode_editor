# ===== GitHub OAuth (PKCE) 配置 =====
# 在 https://github.com/settings/developers 创建一个 OAuth App：
#   - Homepage URL: 任意，例如 https://slipecode.app
#   - Authorization callback URL: slipecode://oauth/callback
# PKCE 流程不需要 client secret，本文件不包含任何机密信息。
GITHUB_CLIENT_ID=

GITHUB_OAUTH_REDIRECT_URI=slipecode://oauth/callback
GITHUB_OAUTH_SCOPES=repo workflow read:user

GITHUB_API_BASE=https://api.github.com
GITHUB_OAUTH_BASE=https://github.com/login/oauth
