# ===== GitHub OAuth (PKCE) 配置 =====
# 在 https://github.com/settings/developers 创建一个 OAuth App：
#   - Homepage URL: 任意，例如 https://slipecode.app
#   - Authorization callback URL: slipecode://oauth/callback
# PKCE 流程不需要 client secret，本文件不包含任何机密信息。
GITHUB_CLIENT_ID=

GITHUB_OAUTH_REDIRECT_URI=slipecode://oauth/callback
GITHUB_OAUTH_SCOPES=repo workflow read:user

GITHUB_API_BASE=https://api.github.com
GITHUB_OAUTH_BASE=https://github.com/login/oauth

# ===== Gitee OAuth 配置 =====
# 在 https://gitee.com/oauth/applications 创建应用：
#   - 回调地址: slipecode://oauth/gitee/callback
# Gitee 原生不支持 PKCE，授权码必须由自建后端用 client_secret 换取 token，
# 因此下方 ACCOUNT_BACKEND_BASE_URL 必须同时配置。
GITEE_CLIENT_ID=

GITEE_OAUTH_REDIRECT_URI=slipecode://oauth/gitee/callback
GITEE_OAUTH_SCOPES=projects user_info

GITEE_API_BASE=https://gitee.com/api/v5
GITEE_OAUTH_BASE=https://gitee.com/oauth

# ===== SlipCode 账号后端 =====
# 部署 backend/ 后的地址，例如 http://10.0.2.2:8787（Android 模拟器访问宿主机）
# 该后端同时提供 Gitee OAuth token 代理接口。
ACCOUNT_BACKEND_BASE_URL=
