# ===== GitHub OAuth 配置 =====
# 在 https://github.com/settings/developers 创建一个 OAuth App：
#   - Homepage URL: 任意，例如 https://slipe.app
#   - Authorization callback URL: https://api.lineregre.com/api/oauth/github/callback
# 授权码由自建后端用 client_secret 换取 token（客户端不含任何 secret）。
GITHUB_CLIENT_ID=

GITHUB_OAUTH_REDIRECT_URI=https://api.lineregre.com/api/oauth/github/callback
GITHUB_OAUTH_SCOPES=repo workflow read:user

GITHUB_API_BASE=https://api.github.com
GITHUB_OAUTH_BASE=https://github.com/login/oauth

# ===== Gitee OAuth 配置 =====
# 在 https://gitee.com/oauth/applications 创建应用：
#   - 回调地址: slipe://oauth/gitee/callback
# Gitee 原生不支持 PKCE，授权码必须由自建后端用 client_secret 换取 token，
# 因此下方 ACCOUNT_BACKEND_BASE_URL 必须同时配置。
GITEE_CLIENT_ID=

GITEE_OAUTH_REDIRECT_URI=slipe://oauth/gitee/callback
GITEE_OAUTH_SCOPES=projects user_info

GITEE_API_BASE=https://gitee.com/api/v5
GITEE_OAUTH_BASE=https://gitee.com/oauth

# ===== SLIPE 账号后端 =====
# 生产环境：https://api.lineregre.com ；本地调试可用 http://10.0.2.2:8787（安卓模拟器）
# 该后端同时提供 Gitee / GitHub OAuth token 代理接口。
ACCOUNT_BACKEND_BASE_URL=https://api.lineregre.com

# ===== 极验验证码（GT4，Android 原生）=====
# Captcha ID 为公开信息；校验用的 Key 只配置在 backend 环境变量中
GEETEST_CAPTCHA_ID=bad52dace656f61eab4b052c157d00b2
