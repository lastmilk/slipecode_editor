<?xml version="1.0" encoding="utf-8"?>
<!-- AI 悬浮球背景：圆形渐变球体（替代系统 btn_default 的灰色方块） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="315"
        android:startColor="#FF7B5CFF"
        android:centerColor="#FF4D6BFF"
        android:endColor="#FF2F80FF"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
